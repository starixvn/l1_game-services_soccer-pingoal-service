{
    "name": "soccer-pingoal-service",
    "version": "1.0.0",
    "description": "",
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/soccer-pingoal"
    },
    "author": "",
    "license": "ISC",
    "main": "./build/app.js",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "jest --testPathPattern=tests/unit-tests/ ",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "npm run build && jest --config ./jest.integration-test.config.cjs --testPathPattern=tests/integration-tests/ --detectOpenHandles --forceExit",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/app.ts",
        "dev-build": "nodemon --experimental-loader=extensionless --watch ./build ./build/app.js",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "awilix": "^8.0.0",
        "extensionless": "^1.9.6",
        "mongoose": "^5.9.25",
        "sc-common": "^1.8.1",
        "sc-core-rng": "^1.1.0",
        "sc-game-base": "^5.4.0",
        "sc-game-management-client": "^0.1.0",
        "socket.io": "^4.5.4"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.23.9",
        "@commitlint/cli": "^18.6.0",
        "@commitlint/config-conventional": "^18.6.0",
        "@types/jest": "^29.5.12",
        "@types/mongoose": "^5.9.25",
        "@types/sc-common": "^1.0.0",
        "@types/sc-game-base": "^1.0.0",
        "@types/sc-game-service-integration-utils": "^1.0.0",
        "cross-env": "^7.0.3",
        "husky": "^9.0.6",
        "jest": "^29.7.0",
        "jest-auto-stub": "^1.0.8",
        "jest-junit": "^16.0.0",
        "jest-micro-auto-stub": "^1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^3.0.3",
        "sc-base-database": "^2.2.0",
        "sc-game-service-integration-utils": "^2.1.0",
        "ts-jest": "^29.1.2",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
