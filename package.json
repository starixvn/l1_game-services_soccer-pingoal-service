{
    "name": "soccer-pingoal-service",
    "version": "1.0.0",
    "description": "",
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/soccer-pingoal"
    },
    "author": "",
    "license": "ISC",
    "main": "./build/app.js",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "jest --testPathPattern=tests/unit-tests/ ",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "",
        "integration-test:skip": "npm run build && jest --config ./jest.integration-test.config.cjs --testPathPattern=tests/integration-tests/ --detectOpenHandles --forceExit",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/app.ts",
        "dev-build": "nodemon --experimental-loader=extensionless --watch ./build ./build/app.js",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "awilix": "12.0.5",
        "extensionless": "1.9.9",
        "mongoose": "8.18.1",
        "sc-common": "3.0.0",
        "sc-core-rng": "1.1.0",
        "sc-game-base": "5.4.0",
        "sc-game-management-client": "0.1.5",
        "socket.io": "4.8.1"
    },
    "devDependencies": {
        "@babel/preset-env": "7.28.3",
        "@commitlint/cli": "19.8.1",
        "@commitlint/config-conventional": "19.8.1",
        "@types/jest": "30.0.0",
        "@types/mongoose": "5.11.97",
        "@types/sc-common": "1.0.2",
        "@types/sc-game-base": "1.1.0",
        "@types/sc-game-service-integration-utils": "1.0.0",
        "cross-env": "10.0.0",
        "husky": "9.1.7",
        "jest": "30.1.3",
        "jest-auto-stub": "1.0.8",
        "jest-junit": "16.0.0",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0",
        "nodemon": "3.1.10",
        "sc-base-database": "2.2.2",
        "sc-game-service-integration-utils": "2.3.1",
        "ts-jest": "29.4.1",
        "tsx": "4.20.5",
        "typescript": "5.9.2"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
